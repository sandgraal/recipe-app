# Copy to .env.local and fill in. NEXT_PUBLIC_* values ship to the browser.

# Supabase (public — already in the deployed bundle)
NEXT_PUBLIC_SUPABASE_URL=https://cjnwvxtomwyszcfuvgpw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key (SECRET — server-only, never NEXT_PUBLIC).
# Required for writes once the recipes-table RLS lock migration is applied.
# Get it from Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin gate for write/import endpoints + admin login. When set, writes require
# the admin cookie (browser login) or `Authorization: Bearer <ADMIN_PASSWORD>`.
ADMIN_PASSWORD=your-admin-password

# Optional: finca whose editors/admins can sign in with their Finca Colibrí
# account (email + password). Default: colibri.
# FINCA_ID=colibri

# Anthropic API key for import / identify / chat / translate.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: origins of the finca hub allowed to call POST /api/cocina/chat
# (comma separated; only this route). Default: https://sandgraal.github.io,
# http://localhost:5173,http://localhost:4173
# HUB_ORIGINS=https://sandgraal.github.io

# Optional: model for every AI call (import, identify, chat, translate, Cocina chat).
# Default: claude-haiku-5-5 (exact id, no date suffix).
# AI_MODEL=claude-haiku-5-5

# Optional: model for the Cocina chat only (wins over AI_MODEL).
# COCINA_CHAT_MODEL=claude-haiku-5-5

# Optional: lock CORS to this origin (defaults to the prod URL).
# NEXT_PUBLIC_SITE_URL=https://recipe-app-blush-eta.vercel.app
